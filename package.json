{
  "name": "breakflow-app",
  "version": "1.0.0",
  "private": true,
  "description": "BreakFlow - Ứng dụng nhắc giải lao, vận động & uống nước cho học sinh, sinh viên và dân văn phòng (IE307.R11 - Chủ đề 14)",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest --watchAll=false",
    "test:watch": "jest --watch",
    "backend:dev": "ts-node-dev --respawn --transpile-only backend/src/server.ts"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-linking": "~7.0.0",
    "expo-localization": "~16.0.0",
    "expo-auth-session": "~6.0.0",
    "expo-crypto": "~14.0.0",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@tanstack/react-query": "^5.59.0",
    "zustand": "^5.0.1",
    "react-hook-form": "^7.53.2",
    "@hookform/resolvers": "^3.9.1",
    "zod": "^3.23.8",
    "@notifee/react-native": "^9.1.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.4.1",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.8.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.3.3"
  }
