    "@babel/core": "^7.25.2",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.14",
