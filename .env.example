# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG MẪU (.env.example)
# Sao chép file này thành .env trước khi chạy dự án
# ==============================================================================

# 1. API & Backend
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# 2. Xác thực bên thứ 3 (OAuth - Google / Facebook / Supabase) - [TV2]
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=your-ios-google-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your-android-google-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=your-web-google-client-id.apps.googleusercontent.com
EXPO_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# 3. Chính sách bảo mật phiên đăng nhập (Session Re-authentication) - [TV2]
# Thời gian tối đa của phiên (mili-giây) trước khi yêu cầu đăng nhập lại (VD: 7 ngày = 604800000, Demo = 900000 (15 phút))
EXPO_PUBLIC_SESSION_MAX_AGE_MS=900000

# 4. Cấu hình App Group / Shared Storage cho Widget & Live Activities - [TV4]
EXPO_PUBLIC_IOS_APP_GROUP=group.com.ie307.healthtracker
EXPO_PUBLIC_ANDROID_SHARED_PREFS=ie307_health_tracker_widget_prefs

# 5. Cấu hình Backend (Dành cho thư mục backend/) - [TV2]
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/health_tracker
JWT_SECRET=replace-with-strong-secret-key
